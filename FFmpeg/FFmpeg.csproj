<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<TargetFramework>netstandard2.1</TargetFramework>
		<Nullable>enable</Nullable>
		<LangVersion>Latest</LangVersion>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<ImplicitUsings>enable</ImplicitUsings>
		<GeneratePackageOnBuild Condition=" $(Configuration) == 'Release' ">true</GeneratePackageOnBuild>
		<GenerateDocumentationFile Condition=" $(Configuration) == 'Release' ">True</GenerateDocumentationFile>
	
		<Title>FFmpeg</Title>
		<Authors>Pascal Krenckel</Authors>
		<Description>A .NET wrapper library for FFmpeg using FFmpeg.AutoGen. This library provides a managed interface for FFmpeg's raw C API by wrapping around the unsafe pointers and structs provided by FFmpeg.AutoGen. It offers a higher-level, object-oriented approach to access and manipulate FFmpeg's core functionality, making it easier to integrate FFmpeg into .NET applications.

Simplifies working with FFmpeg by providing a safer, managed wrapper around the native FFmpeg API.

Exposes FFmpeg's powerful multimedia processing capabilities in a more accessible, object-oriented format.

Reduces the need to work directly with pointers and memory management, leveraging the safety of C# for easier debugging and development.

Ideal for .NET developers who need to integrate FFmpeg's audio and video processing, transcoding, streaming, and encoding/decoding capabilities in their applications.</Description>
		<Copyright>Copyright (c) 2026 Pascal Krenckel. All rights reserved.</Copyright>
		<PackageProjectUrl>https://github.com/Pascal-Krenckel/FFmpeg</PackageProjectUrl>
		<RepositoryUrl>https://github.com/Pascal-Krenckel/FFmpeg</RepositoryUrl>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>ffmpeg</PackageTags>
		<PackageId>FFmpegDotNet</PackageId>
		<IncludeSymbols>True</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<Version>8.1.2.10</Version>
		<PackageReleaseNotes>
			--- 8.1.2.10 ---
			BugFix: CancellableWorkItem would still perform the action if canceled.
			FFmpeg.Helper.Exceptions include now static extenstions for easy throwing, especially under .netstandard (e.g. ObjectDisposeException.ThrowIfTrue(bool,this))
			--- 8.1.2.9 ---
			Added FFmpegWorkQueue, a concurrency-limited work queue for asynchronous FFmpeg operations.
			Supports cancellable send/receive operations for codecs and filters, hardware frame reception, arbitrary FFmpeg work such as seeking, configurable concurrency, and synchronous/asynchronous disposal.
			CancellableWorkItem operations can be awaited directly.
			--- 8.1.2.8 ---
			BugFix: Peek samples calculation missing "/ Channels"
			BugFix: FilterGraph Copy ignores auto_ filters. Added Flush().
			BugFix: AVResult.ThrowIfError now throws if error is TryAgain
			Added class FFmpeg.Collections.CircularArray&lt;T&gt;
			Added MediaPlayer namespace for easy MediaPlayer implementation (see example project 9.)
			--- 8.1.2.7 ---
			Readme fixed
			--- 8.1.2.6 ---
			FFmpegDotNet._AutoGen was not build against FFmpeg 8.1.2 but master - FFmpeg 9.0 (pre)
			--- 8.1.2.5 ---
			Reworked filtering
			Removed dupplicated function in filters, moved FilterContext Create[Filter] function in Audio/VideoFilters.
			Documentation
			Some BugFixes in FilterGraph

			--- 8.1.2.4 ---
			BugFix: FormatContext.WritePacket wrote interleaved packets previously.
			BugFix/full implementation: MediaSink is now fully implemented, some bugs got fixed
			BugFix: SwsContext copies now into "readonly" AVFrame
			BugFix: SwsContext does create a Buffer if the frame does not have one. The plane pointers are fetched after the buffer was created
			--- 8.1.2.3 ---
			XML Docu no in nuget package
			Support for custom audio channel layout
			AudioFifo-Bugfix
			Some smaller changes
			--- 8.1.2.2 ---
			Added namespace FFmpeg.Logging for logging.
			--- 8.1.2.1 ---
			MediaSource now copies the streams timebase into the CodecContexts timebase.
			The CodecContexts timebase is writen into the frame if the  frame's timebase's numerator is 0.
			=== 8.1.2 ===
			Update to ffmpeg 8.1.2 "Hoarse".
			FormatContext was split into DemuxerContext and MuxerContext.
			MediaSource no longer thread-safe. It doesn't make sense to make it thread-safe as most of the time it will only be called from one thread.
			Update dependencies.
		</PackageReleaseNotes>
</PropertyGroup>

	<ItemGroup>
		<None Include="..\Developer Guide.md" Link="Developer Guide.md" />
		<None Include="..\LICENSE.txt">
		  <Pack>True</Pack>
		  <PackagePath>\</PackagePath>
		</None>
		<None Include="..\README.md" Pack="true" PackagePath="\" />
		<PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.400">
		  <PrivateAssets>all</PrivateAssets>
		  <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="System.IO.Pipelines" Version="10.0.11" />
		<PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
		<PackageReference Include="System.Security.Permissions" Version="10.0.11" />
		<PackageReference Condition=" $(Configuration) == 'Release' " Include="FFmpegDotNet._AutoGen" Version="[8.1.2.4,9)" />
		<ProjectReference Condition=" $(Configuration) == 'Debug' " Include="..\FFmpeg.AutoGen\FFmpeg.AutoGen\FFmpeg.AutoGen.csproj" />
		<Using Include="FFmpeg.AutoGen.ffmpeg">
			<Alias>ffmpeg</Alias>
		</Using>
		<Using Include="FFmpeg.Helper" />
		<Using Include="System.Runtime.CompilerServices.IsExternalInit">
		  <Static>True</Static>
		</Using>
	</ItemGroup>
</Project>
