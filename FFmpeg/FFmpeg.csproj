<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<TargetFramework>netstandard2.1</TargetFramework>
		<Nullable>enable</Nullable>
		<LangVersion>Latest</LangVersion>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<ImplicitUsings>enable</ImplicitUsings>
		<GeneratePackageOnBuild Condition=" $(Configuration) == 'Release' ">true</GeneratePackageOnBuild>
		<Title>FFmpeg</Title>
		<Authors>Pascal Krenckel</Authors>
		<Description>A .NET wrapper library for FFmpeg using FFmpeg.AutoGen. This library provides a managed interface for FFmpeg's raw C API by wrapping around the unsafe pointers and structs provided by FFmpeg.AutoGen. It offers a higher-level, object-oriented approach to access and manipulate FFmpeg's core functionality, making it easier to integrate FFmpeg into .NET applications.

Simplifies working with FFmpeg by providing a safer, managed wrapper around the native FFmpeg API.

Exposes FFmpeg's powerful multimedia processing capabilities in a more accessible, object-oriented format.

Reduces the need to work directly with pointers and memory management, leveraging the safety of C# for easier debugging and development.

Ideal for .NET developers who need to integrate FFmpeg's audio and video processing, transcoding, streaming, and encoding/decoding capabilities in their applications.</Description>
		<Copyright>Copyright (c) 2025 Pascal Krenckel. All rights reserved.</Copyright>
		<PackageProjectUrl>https://github.com/Pascal-Krenckel/FFmpeg</PackageProjectUrl>
		<RepositoryUrl>https://github.com/Pascal-Krenckel/FFmpeg</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>ffmpeg</PackageTags>
		<PackageId>FFmpegDotNet</PackageId>
		<IncludeSymbols>True</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<PackageLicenseFile>LICENSE.txt</PackageLicenseFile>
		<Version>8.1.2.1</Version>
		<PackageReleaseNotes>
			--- 8.1.2.1 ---
			MediaSource now copies the streams timebase into the CodecContexts timebase.
			The CodecContexts timebase is writen into the frame if the  frame's timebase's numerator is 0.
			=== 8.1.2 ===
			Update to ffmpeg 8.1.2 "Hoarse".
			FormatContext was split into DemuxerContext and MuxerContext.
			MediaSource no longer thread-safe. It doesn't make sense to make it thread-safe as most of the time it will only be called from one thread.
			Update dependencies.
		</PackageReleaseNotes>
</PropertyGroup>

	<ItemGroup>
		<None Include="..\Developer Guide.md" Link="Developer Guide.md" />
		<None Include="..\LICENSE.txt">
		  <Pack>True</Pack>
		  <PackagePath>\</PackagePath>
		</None>
		<None Include="..\README.md" Pack="true" PackagePath="\" />
		<PackageReference Include="System.IO.Pipelines" Version="10.0.10" />
		<PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
		<PackageReference Include="System.Security.Permissions" Version="10.0.10" />
		<PackageReference Condition=" $(Configuration) == 'Release' " Include="FFmpegDotNet._AutoGen" Version="[8.1.2.1,8.2)" />
		<ProjectReference Condition=" $(Configuration) == 'Debug' " Include="..\FFmpeg.AutoGen\FFmpeg.AutoGen\FFmpeg.AutoGen.csproj" />
		<Using Include="FFmpeg.AutoGen.ffmpeg">
			<Alias>ffmpeg</Alias>
		</Using>
		<Using Include="FFmpeg.Helper" />
		<Using Include="System.Runtime.CompilerServices.IsExternalInit">
		  <Static>True</Static>
		</Using>
	</ItemGroup>
</Project>
