{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",

  "metadata": [
    {
      "src": [
        {
          "src": ".",
          "files": [
            "FFmpeg/FFmpeg.csproj"
          ]
        }
      ],
      "dest": "api",
      "properties": {
        "Configuration": "Release",
        "TargetFramework": "net10.0"
      }
    }
  ],

  "build": {
    "content": [
      {
        "files": [
          "api/**.yml",
          "api/index.md"
        ]
      }
    ],

    "output": "_site",

    "template": [
      "default"
    ]
  }
}