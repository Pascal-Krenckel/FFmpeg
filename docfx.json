{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",

  "metadata": [
    {
      "src": [
        {
          "src": "FFmpeg/bin/Release/net10.0",
          "files": [
            "FFmpeg.dll"
          ]
        }
      ],
      "dest": "api"
    }
  ],

  "build": {
    "content": [
      {
        "files": [
          "README.md",
          "api/**.yml"
        ]
      }
    ],
    "output": "_site",
    "template": [
      "default"
    ]
  }
}